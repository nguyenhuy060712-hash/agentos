# Mẫu biến môi trường cho systemd EnvironmentFile (vd /etc/agentos/agentos.env, quyền 600, chủ root).
# Chỉ có TÊN biến. Giá trị thật lấy từ thư mục bí mật, KHÔNG commit file đã điền.

# --- Bắt buộc ---
PG_URI=postgresql://<user>:<mật khẩu>@127.0.0.1:5432/langgraph
GOOGLE_API_KEY=<khoá Gemini>
AOS_FILES_DIR=/opt/agentos/var/files
AOS_SECRET_KEY_FILE=/opt/agentos/var/aos_secret.key   # khoá gốc mã hoá; sao lưu riêng, mất là không đọc lại được dữ liệu mã hoá

# --- Nên có ---
AOS_OAUTH_KEY=<khoá mã hoá token OAuth>               # bắt buộc nếu dùng Kết nối Google/Microsoft/MCP OAuth
AOS_PUBLIC_URL=https://<địa chỉ công khai>             # dùng cho link OAuth, link chia sẻ
AOS_DEFAULT_TZ=Asia/Ho_Chi_Minh
AOS_SELF_IPS=<IP public của VPS>                       # sàn chặn mạng: chặn tự gọi chính mình

# --- Tuỳ chọn ---
# OPENAI_API_KEY=                                      # nếu bật nhà cung cấp OpenAI trong LLM Gateway
# AOS_EGRESS_ALLOW=                                    # địa chỉ nội bộ được phép gọi ra (để trống = chỉ Internet)
# AOS_EGRESS_DENY_HOSTS=                               # luôn chặn, thắng AOS_EGRESS_ALLOW
# AOS_SCHEDULES_DISABLED=1                             # công tắc tắt mọi lịch chạy
# AOS_VOICE_REAL_PROVIDERS=google
# AOS_A8_ABORT_USD=2.00                                # trần tiền voice thật
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASSWORD= SMTP_FROM=   # gửi email thông báo
# AOS_MOCK_OAUTH=1                                     # CHỈ máy thử nghiệm; không đặt trên VPS thật
