---
// One training module: sidebar, header, body (ModuleBody), "on this page" list, prev/next.
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import Lightbox from "../../components/Lightbox.astro";
import ModuleBody from "../../components/dao-tao/ModuleBody.astro";
import TrainNav from "../../components/dao-tao/TrainNav.astro";
import { modules, moduleHref, slideHref, tracks, roles } from "../../data/training/programme";
import { trackCls } from "../../lib/training";

export function getStaticPaths() {
  return modules.map((m) => ({ params: { slug: m.slug }, props: { n: m.n } }));
}
const { slug } = Astro.params;
const m = modules.find((x) => x.slug === slug)!;
const prev = modules[m.n - 2];
const next = modules[m.n];
---
<Site lang="vi" active="training" path={moduleHref(m.slug)} alt={null} type="LearningResource"
  title={`Buổi ${m.n}: ${m.title} | Đào tạo Chuyên gia Agent OS`} desc={m.summary}>
  <div class="mx-auto w-full max-w-[90rem] px-4 sm:px-6">
    <TrainNav variant="mobile" current={m.slug} />
    <div class="lg:grid lg:grid-cols-[15.5rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[15.5rem_minmax(0,1fr)_13rem]">
      <aside class="hidden lg:block"><TrainNav variant="side" current={m.slug} /></aside>

      <article class="min-w-0 py-10 pb-24 sm:py-14">
        <p class="text-sm text-zinc-500"><a class="hover:text-zinc-900 dark:hover:text-white" href="/dao-tao/">Đào tạo</a> / Buổi {m.n}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-zinc-500">Buổi {m.n}/{modules.length} · {m.hours} giờ</span>
          <span class={`chip ${trackCls[m.track]}`}>{tracks[m.track].t}</span>
          {m.roles.map((r) => <span class="chip bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{roles[r].t}</span>)}
        </div>
        <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight sm:text-[2.6rem]" style="text-wrap: balance;">{m.title}</h1>
        <p class="lead !max-w-3xl">{m.summary}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn-primary" href={slideHref(m.slug)}>Trình chiếu <Icon name="arrow" class="h-4 w-4" /></a>
          <a class="btn-ghost" href="/dao-tao/#lich">Lịch 12 buổi</a>
        </div>

        <div class="mt-8 max-w-3xl" id="lesson-body"><ModuleBody m={m} /></div>

        <nav class="mt-14 grid max-w-3xl gap-3 sm:grid-cols-2" aria-label="Buổi trước và buổi sau">
          {prev ? <a href={moduleHref(prev.slug)} class="card !p-4 hover:border-violet-400"><span class="text-xs text-zinc-500">← Buổi {prev.n}</span><span class="mt-1 block font-semibold">{prev.short}</span></a> : <a href="/dao-tao/" class="card !p-4 hover:border-violet-400"><span class="text-xs text-zinc-500">←</span><span class="mt-1 block font-semibold">Tổng quan chương trình</span></a>}
          {next ? <a href={moduleHref(next.slug)} class="card !p-4 text-right hover:border-violet-400"><span class="text-xs text-zinc-500">Buổi {next.n} →</span><span class="mt-1 block font-semibold">{next.short}</span></a> : <a href="/dao-tao/chung-nhan/" class="card !p-4 text-right hover:border-violet-400"><span class="text-xs text-zinc-500">Tiếp theo →</span><span class="mt-1 block font-semibold">Thi và chứng nhận</span></a>}
        </nav>
      </article>

      <aside class="hidden xl:block">
        <nav class="sticky top-14 py-14 text-sm" aria-label="Trên trang này">
          <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-zinc-400">Trên trang này</p>
          <div id="otp" class="grid gap-0.5"></div>
        </nav>
      </aside>
    </div>
  </div>
  <Lightbox close="Đóng" />
</Site>

<script>
  // "On this page" list from the h2 headings + scroll-spy.
  const body = document.getElementById("lesson-body");
  const otp = document.getElementById("otp");
  const heads = [...(body?.querySelectorAll<HTMLElement>("h2[id]") ?? [])];
  for (const h of heads) {
    const a = document.createElement("a");
    a.href = `#${h.id}`; a.textContent = h.textContent; a.className = "toc-link !py-1 text-[13px]"; a.dataset.h = h.id;
    otp?.appendChild(a);
  }
  const io = new IntersectionObserver((es) => {
    for (const e of es) if (e.isIntersecting) otp?.querySelectorAll<HTMLElement>("a").forEach((a) => a.classList.toggle("is-active", a.dataset.h === e.target.id));
  }, { rootMargin: "-15% 0px -75% 0px" });
  heads.forEach((h) => io.observe(h));
  document.querySelectorAll(".toc-mobile nav a").forEach((a) => a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
</script>
