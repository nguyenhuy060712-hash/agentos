---
// Full-screen slide deck of one module (16:9). Keys: ← → Space PageUp PageDown Home End, F = full screen. #3 deep-links slide 3.
import Base from "../../../layouts/Base.astro";
import SlideDeck from "../../../components/dao-tao/SlideDeck.astro";
import { modules, moduleHref, slideHref } from "../../../data/training/programme";

export function getStaticPaths() {
  return modules.map((m) => ({ params: { slug: m.slug } }));
}
const { slug } = Astro.params;
const m = modules.find((x) => x.slug === slug)!;
---
<Base lang="vi" title={`Trình chiếu buổi ${m.n}: ${m.title} | Đào tạo Chuyên gia Agent OS`} desc={m.summary} ogAlt={m.title} locale="vi_VN" path={slideHref(m.slug)} alt={null} type="PresentationDigitalDocument">
  <div class="deck" id="deck">
    <div class="deck-top">
      <a href={moduleHref(m.slug)} class="font-semibold">← Bài giảng</a>
      <span class="truncate opacity-70">Buổi {m.n} · {m.short}</span>
    </div>
    <SlideDeck m={m} />
    <div class="deck-ui" role="toolbar" aria-label="Điều khiển trình chiếu">
      <a href={moduleHref(m.slug)}>← Bài giảng</a>
      <button type="button" id="prev" aria-label="Slide trước">←</button>
      <span id="count" aria-live="polite" class="min-w-[4.5rem] text-center">1 / 1</span>
      <button type="button" id="next" aria-label="Slide sau">→</button>
      <span class="sp"></span>
      <button type="button" id="theme-d" aria-label="Đổi giao diện sáng/tối">Sáng/Tối</button>
      <button type="button" id="fs" aria-label="Toàn màn hình (phím F)">Toàn màn hình · F</button>
    </div>
    <div class="deck-bar" id="bar" role="presentation"></div>
  </div>
</Base>

<script>
  const deck = document.getElementById("deck")!;
  const slides = [...deck.querySelectorAll<HTMLElement>(".slide")];
  const wide = matchMedia("(min-width: 768px)");
  const count = document.getElementById("count")!;
  const bar = document.getElementById("bar")!;
  let i = 0;
  const clamp = (n: number) => Math.max(0, Math.min(slides.length - 1, n));
  function show(n: number, push = true) {
    i = clamp(n);
    slides.forEach((s, k) => s.classList.toggle("is-on", k === i));
    count.textContent = `${i + 1} / ${slides.length}`;
    bar.style.width = `${((i + 1) / slides.length) * 100}%`;
    if (push) history.replaceState(null, "", `#${i + 1}`);
  }
  const fromHash = () => { const n = parseInt(location.hash.slice(1), 10); return Number.isFinite(n) ? clamp(n - 1) : 0; };
  function sync() {
    if (wide.matches) show(fromHash(), false);
    else { slides.forEach((s) => s.classList.remove("is-on")); const n = parseInt(location.hash.slice(1), 10); if (n) slides[clamp(n - 1)].scrollIntoView(); }
  }
  wide.addEventListener("change", sync);
  addEventListener("hashchange", () => { if (wide.matches) show(fromHash(), false); });
  sync();

  const go = (d: number) => { if (wide.matches) show(i + d); };
  document.getElementById("prev")!.addEventListener("click", () => go(-1));
  document.getElementById("next")!.addEventListener("click", () => go(1));
  const fs = () => { if (document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen?.().catch(() => {}); };
  document.getElementById("fs")!.addEventListener("click", fs);
  document.getElementById("theme-d")!.addEventListener("click", () => {
    const d = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", d ? "dark" : "light"); } catch (e) {}
  });
  addEventListener("keydown", (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || !wide.matches) return;
    const k = e.key;
    if (k === "ArrowRight" || k === "ArrowDown" || k === "PageDown" || k === " ") { e.preventDefault(); go(1); }
    else if (k === "ArrowLeft" || k === "ArrowUp" || k === "PageUp") { e.preventDefault(); go(-1); }
    else if (k === "Home") { e.preventDefault(); show(0); }
    else if (k === "End") { e.preventDefault(); show(slides.length - 1); }
    else if (k === "f" || k === "F") { e.preventDefault(); fs(); }
  });
  // Click the left / right half of a slide to go back / forward (links, buttons and code blocks keep their own behaviour).
  deck.addEventListener("click", (e) => {
    if (!wide.matches || (e.target as Element).closest("a, button, pre, .deck-ui")) return;
    go(e.clientX < innerWidth / 2 ? -1 : 1);
  });
  // Printing always uses the light theme.
  let wasDark = false;
  addEventListener("beforeprint", () => { wasDark = document.documentElement.classList.contains("dark"); document.documentElement.classList.remove("dark"); });
  addEventListener("afterprint", () => { if (wasDark) document.documentElement.classList.add("dark"); });
</script>
