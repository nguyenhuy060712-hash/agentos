---
import Site from "../../layouts/Site.astro";
import Icon from "../../components/Icon.astro";
import { lessons, levels, lessonHref } from "../../data/lessons";
const total = lessons.reduce((n, l) => n + l.mins, 0);
const lvlCls = { 1: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-300", 2: "bg-sky-100 text-sky-800 dark:bg-sky-500/15 dark:text-sky-300", 3: "bg-violet-100 text-violet-800 dark:bg-violet-500/15 dark:text-violet-300" };
const each = ["Mục tiêu bài học", "Ví dụ đời thường", "Sơ đồ dựng sẵn", "Thực hành bấm trên Agent OS", "Câu hỏi tự kiểm tra", "Thuật ngữ có giải thích"];
---
<Site lang="vi" active="learn" path="/hoc/" alt={null} type="Course"
  title="Hiểu và xây dựng hệ thống AI Agent với Agent OS | Khoá học miễn phí"
  desc="Khoá học 7 bài, từ cơ bản tới nâng cao, cho người muốn hiểu, thiết kế và xây hệ thống AI agent mà không cần biết lập trình sâu. Mỗi bài có ví dụ đời thường, sơ đồ, thực hành trên Agent OS và câu hỏi tự kiểm tra.">
  <section class="relative overflow-hidden border-b border-zinc-200 dark:border-zinc-800">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-48 -z-10 mx-auto h-[30rem] max-w-4xl opacity-25 blur-3xl grad-bg dark:opacity-20" style="border-radius:50%"></div>
    <div class="wrap py-14 sm:py-20">
      <p class="kicker"><Icon name="book" class="h-3.5 w-3.5" />Khoá học · tiếng Việt · miễn phí</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-[1.1] sm:text-5xl" style="text-wrap: balance;">Hiểu và xây dựng hệ thống <span class="grad-text">AI Agent</span> với Agent OS</h1>
      <p class="lead text-lg">Dành cho chủ doanh nghiệp, quản lý, người làm vận hành muốn hiểu agent hoạt động thế nào, thiết kế được một hệ thống agent cho công ty mình và tự dựng nó trên Agent OS. Không cần biết lập trình: chỗ nào có mã thì chỉ vài dòng, kèm giải thích.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={lessonHref(lessons[0].slug)}>Bắt đầu bài 1 <Icon name="arrow" class="h-4 w-4" /></a>
        <a class="btn-ghost" href="/tinh-nang/">Xem tính năng Agent OS</a>
      </div>
      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4">
        <div><dd class="font-display text-2xl font-bold text-zinc-950 dark:text-white">{lessons.length} bài</dd><dt class="text-sm text-zinc-500">3 cấp độ</dt></div>
        <div><dd class="font-display text-2xl font-bold text-zinc-950 dark:text-white">~{Math.round(total / 60 * 10) / 10} giờ</dd><dt class="text-sm text-zinc-500">kể cả thực hành</dt></div>
        <div><dd class="font-display text-2xl font-bold text-zinc-950 dark:text-white">0 đồng</dd><dt class="text-sm text-zinc-500">thực hành trên máy thử, AI giả lập</dt></div>
      </dl>
    </div>
  </section>

  <section class="wrap py-14">
    <h2 class="h2">Lộ trình</h2>
    <p class="lead">Học theo thứ tự: mỗi bài dùng lại khái niệm của bài trước. Bài 7 ghép tất cả thành một hệ thống hoàn chỉnh.</p>
    <ol class="mt-10 grid gap-4" id="course">
      {lessons.map((l) => (
        <li>
          <a href={lessonHref(l.slug)} class="card group flex gap-4 !p-5 transition hover:border-violet-400 sm:gap-6 sm:!p-6">
            <span class="lesson-num grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-zinc-100 font-display text-lg font-bold text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200" data-slug={l.slug}>{l.n}</span>
            <span class="min-w-0 flex-1">
              <span class="flex flex-wrap items-center gap-2 text-xs">
                <span class={`chip ${lvlCls[l.level]}`}>{levels[l.level]}</span>
                <span class="text-zinc-500">khoảng {l.mins} phút</span>
                <span class="done-tag hidden font-semibold text-emerald-600 dark:text-emerald-400" data-slug={l.slug}>✓ Đã học</span>
              </span>
              <span class="mt-2 block text-lg font-semibold text-zinc-950 group-hover:text-violet-700 dark:text-white dark:group-hover:text-violet-300">{l.title}</span>
              <span class="mt-1 block text-[15px] text-zinc-600 dark:text-zinc-400">{l.summary}</span>
            </span>
            <Icon name="arrow" class="mt-1 hidden h-5 w-5 shrink-0 text-zinc-400 group-hover:text-violet-600 sm:block" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-t border-zinc-200 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-950/40">
    <div class="wrap grid gap-10 py-14 lg:grid-cols-2">
      <div>
        <h2 class="h2">Mỗi bài có gì</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {each.map((e) => <li class="flex items-center gap-2.5 text-[15px]"><span class="grid h-6 w-6 place-items-center rounded-full grad-bg text-xs text-white">✓</span>{e}</li>)}
        </ul>
      </div>
      <div class="card">
        <h3 class="font-semibold">Chuẩn bị để thực hành</h3>
        <ul class="mt-3 grid gap-2 text-[15px] text-zinc-600 dark:text-zinc-400">
          <li>• Một tài khoản Agent OS (máy thử hoặc bản demo, do MozaAI cấp).</li>
          <li>• Trình duyệt trên máy tính; điện thoại dùng được nhưng màn hình nhỏ.</li>
          <li>• Không cần thẻ thanh toán: máy thử dùng AI giả lập, kênh mô phỏng.</li>
          <li>• Không bao giờ dán mật khẩu hay khoá API vào ô chat; khoá chỉ nhập ở kho bí mật.</li>
        </ul>
      </div>
    </div>
  </section>
</Site>

<script>
  try {
    const done: string[] = JSON.parse(localStorage.getItem("agentos-hoc-done") || "[]");
    document.querySelectorAll<HTMLElement>(".done-tag").forEach((el) => el.classList.toggle("hidden", !done.includes(el.dataset.slug!)));
    document.querySelectorAll<HTMLElement>(".lesson-num").forEach((el) => {
      const on = done.includes(el.dataset.slug!);
      el.classList.toggle("grad-bg", on); el.classList.toggle("!text-white", on);
    });
  } catch {}
</script>
