---
// Shared page shell: <head> (Base), sticky header with primary nav, footer, theme toggle.
import { Image } from "astro:assets";
import Base from "./Base.astro";
import Ext from "../components/Ext.astro";
import logo from "../assets/mozaai-icon.png";
import { LINKS } from "../data/content";
import { ui, routes, type Lang } from "../data/ui";

interface Props { lang: Lang; title: string; desc: string; path: string; alt?: string | null; active?: "home" | "features" | "learn" | "training"; type?: string; noindex?: boolean }
const { lang, title, desc, path, alt, active, type, noindex } = Astro.props;
const t = ui[lang];
const r = routes[lang];
const other = alt === undefined ? (lang === "vi" ? "/en/" : "/") : alt ?? (lang === "vi" ? "/en/" : "/");
const nav = [
  { key: "features", href: r.features, label: t.nav.features },
  { key: "compare", href: r.compare, label: t.nav.compare },
  { key: "learn", href: r.learn, label: t.nav.learn },
  { key: "training", href: r.training, label: t.nav.training },
] as const;
---
<Base lang={lang} title={title} desc={desc} ogAlt={title} locale={lang === "vi" ? "vi_VN" : "en_US"} path={path} alt={alt} type={type} noindex={noindex}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow">{t.nav.skip}</a>
  <header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/85 backdrop-blur-md dark:border-zinc-800/70 dark:bg-[#111214]/85">
    <div class="mx-auto flex h-14 w-full max-w-[90rem] items-center gap-3 px-4 sm:px-6">
      <a href={r.home} class="flex shrink-0 items-center gap-2 whitespace-nowrap font-display font-bold text-zinc-950 dark:text-white" aria-label="Agent OS – MozaAI">
        <Image src={logo} alt="" width={26} height={26} class="h-6.5 w-6.5" loading="eager" />
        <span>Agent OS</span>
      </a>
      <nav class="ml-3 hidden items-center gap-0.5 md:flex" aria-label={lang === "vi" ? "Chính" : "Primary"}>
        {nav.map((n) => <a class:list={["navlink", active === n.key && "!text-zinc-950 font-semibold dark:!text-white"]} href={n.href} aria-current={active === n.key ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <div class="ml-auto flex items-center gap-1">
        <a href={other} hreflang={lang === "vi" ? "en" : "vi"} lang={lang === "vi" ? "en" : "vi"} class="navlink font-semibold" aria-label={t.nav.otherLabel}>{t.nav.other}</a>
        <button id="theme" type="button" class="navlink" aria-label={t.nav.theme} title={t.nav.theme}>
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <Ext class="btn-primary hidden whitespace-nowrap !px-4 !py-1.5 sm:inline-flex" href={LINKS.chat} label={t.newTab}>{t.nav.demo}</Ext>
        <details class="relative md:hidden">
          <summary class="navlink list-none cursor-pointer" aria-label={t.nav.menu}>
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav class="absolute right-0 mt-2 grid w-60 gap-0.5 rounded-xl border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-900" aria-label="Mobile">
            <a class="navlink block" href={r.home}>{t.nav.home}</a>
            {nav.map((n) => <a class="navlink block" href={n.href}>{n.label}</a>)}
            <Ext class="navlink block" href={LINKS.chat} label={t.newTab}>{t.nav.demo}</Ext>
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="border-t border-zinc-200 py-10 text-sm text-zinc-500 dark:border-zinc-800">
    <div class="mx-auto flex w-full max-w-[90rem] flex-wrap items-center gap-x-6 gap-y-3 px-4 sm:px-6">
      <span class="flex items-center gap-2"><Image src={logo} alt="" width={20} height={20} class="h-5 w-5" />{t.footer.made}</span>
      <a class="hover:text-zinc-900 dark:hover:text-white" href={r.features}>{t.nav.features}</a>
      <a class="hover:text-zinc-900 dark:hover:text-white" href={r.learn}>{t.nav.learn}</a>
      <a class="hover:text-zinc-900 dark:hover:text-white" href={r.training}>{t.nav.training}</a>
      <Ext class="hover:text-zinc-900 dark:hover:text-white" href={LINKS.agentos} label={t.newTab}>Agent OS</Ext>
      <Ext class="hover:text-zinc-900 dark:hover:text-white" href={LINKS.chat} label={t.newTab}>Agent OS Chat</Ext>
      <Ext class="hover:text-zinc-900 dark:hover:text-white" href={LINKS.mozaai} label={t.newTab}>mozaai.vn</Ext>
      <span class="ml-auto">{t.footer.updated}</span>
      <a href="#main" class="hover:text-zinc-900 dark:hover:text-white">{t.footer.top} ↑</a>
    </div>
  </footer>

  <script>
    document.getElementById("theme")?.addEventListener("click", () => {
      const d = document.documentElement.classList.toggle("dark");
      try { localStorage.setItem("theme", d ? "dark" : "light"); } catch (e) {}
    });
    document.querySelectorAll("header details nav a").forEach((a) => a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
  </script>
</Base>
